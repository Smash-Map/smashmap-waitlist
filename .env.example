# Copier en `.env`, puis `node env.mjs` (génère env.js, lu par les deux pages).
# Même projet Supabase que l'app : mêmes valeurs que EXPO_PUBLIC_SUPABASE_URL /
# EXPO_PUBLIC_SUPABASE_ANON_KEY de apps/mobile/.env (Project Settings → API).
# Clés publiques par nature (elles finissent dans la page), mais pas de dev dans
# le dépôt : env.js est ignoré par git. Vide = mode démo, rien n'est envoyé.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
